// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum SubtitleStatus {
  PENDING
  READY
  FAILED
}


// User model with fields for authentication, profile, and metadata. Password is optional for users authenticated via 42/Google.
model User {
  id                String   @id @default(uuid())
  username          String   @unique
  email             String   @unique
  firstName         String
  lastName          String
  
  // Password is optional to allow for users authenticated via 42 or Google. For local auth, it will be required.
  password          String?  
  
  // Default profile picture and language
  profilePictureUrl String   @default("https://default-avatar.com/avatar.png")
  preferredLanguage String   @default("en")
  
  // Omniauth ID (for linking third-party accounts)
  fortyTwoId        String?  @unique
  googleId          String?  @unique
  
  // Security tokens
  resetPasswordToken   String?  @unique
  resetPasswordExpires DateTime?
  
  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relationships
  movieViews MovieView[]
  comments Comment[]
}


model Movie {
  id          String   @id @default(uuid())
  imdbId       String   @unique
  title       String
  year        Int
  rating      Float @default(0.0) // Average rating, default to 0.0 if not provided
  runtime     Int @default(0) // Runtime in minutes, default to 0 if not provided
  genres      String[] // Array of genres
  summary     String @db.Text
  coverImageUrl String
  

  // Cast and crew 
  director    String?
  cast       String[] // Array of main cast members

  // If the fils isn't watched over a month, it will be deleted from the database
  lastViewedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  torrents Torrent[] // Relationship to Torrent model
  movieViews MovieView[] // Relationship to MovieView model for tracking user views
  comments Comment[] // Relationship to Comment model
  subtitles MovieSubtitle[]
}


model Torrent {
  id        String   @id @default(uuid())
  hash      String   @unique // Unique hash for the torrent
  magnet    String // Magnet link for the torrent
  quality   String // Quality of the torrent (e.g., 720p, 1080p)
  size      String // Size of the torrent in bytes
  seeds     Int @default(0) // Number of seeds for the torrent
  peers     Int @default(0) // Number of peers for the torrent

  // Status of the torrent (e.g., "available", "downloading", "downloaded")
  isDownloaded Boolean @default(false)
  filePath    String? // File path where the torrent is stored after download

  // Relationship to Movie model
  movieId    String
  movie      Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// MovieView model to track when users watch movies
model MovieView {
  id        String   @id @default(uuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId   String
  movie     Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  
  viewedAt  DateTime @default(now())
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Ensure each user can only have one "current" view record per movie
  @@unique([userId, movieId])
}

// Comment model to track movie discussion
model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text

  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  movieId   String
  movie     Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([movieId])
  @@index([userId])
}

model MovieSubtitle {
  id                String         @id @default(uuid())
  movieId            String
  movie              Movie          @relation(fields: [movieId], references: [id], onDelete: Cascade)
  languageCode       String
  format             String         @default("vtt")
  provider           String?
  providerSubtitleId String?
  filePath           String?
  status             SubtitleStatus @default(PENDING)
  errorMessage       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([movieId, languageCode])
  @@index([movieId])
}